# -----------------------------
# Common .gitignore for this repo
# - Backend: .NET / Visual Studio
# - Frontend: Node / Vite
# - IDE/editor and OS files
# - Build outputs, logs, secrets
# -----------------------------

# Visual Studio / .NET
bin/
obj/
Debug*/
Release*/
*.user
*.suo
*.userosscache
*.sln.docstates
*.userprefs
*.ide

# Rider / JetBrains
.idea/
*.iml

# NuGet and packages
*.nupkg
*.snupkg
packages/
project.lock.json
project.assets.json

# Build / publish output
publish/
out/
*.dll
*.exe

# Logs and temporary files
*.log
logs/
*.tmp
*.temp

# Debug / symbols
*.pdb
*.mdb

# VS Code
# keep .vscode/* if you want to share workspace settings; ignore by default
.vscode/
*.code-workspace

# Node / Frontend
node_modules/
dist/
.vite/
.cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment / secrets
.env
.env.*
secrets.*
appsettings.*.Local
appsettings.*.Local.json

# OS files
.DS_Store
Thumbs.db

# Databases
*.mdf
*.ldf
*.sqlite
*.sqlite3

# Test / coverage
TestResults/
coverage/
*.coverage
*.coveragexml
*.trx